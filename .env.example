# API Keys (required for agent system)
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# Agent Configuration
AGENT_MODEL=claude-3-5-sonnet-20241022
AGENT_TEMPERATURE=0.7
MAX_ITERATIONS=10

# Infrastructure URLs (auto-configured in docker-compose)
PROMETHEUS_URL=http://prometheus:9090
ELASTICSEARCH_URL=http://elasticsearch:9200
GRAFANA_URL=http://grafana:3000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Chaos Engineering
CHAOS_ENABLED=false
CHAOS_INTERVAL=300  # seconds

# Data Collection
COLLECT_METRICS_INTERVAL=30  # seconds
COLLECT_LOGS_INTERVAL=60  # seconds
